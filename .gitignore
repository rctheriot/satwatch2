# Godot
.godot/
/android/
/build/

# Python
.venv/

# earth.glb: a Sketchfab reference model dropped into assets/ for comparison,
# not used by the scene (see assets/README.md -- only its cloud alpha layer
# was extracted, as earth_clouds.png, which IS committed). Godot auto-imports
# anything under res://, which is all these entries are: import byproducts.
/assets/earth.glb
/assets/earth.glb.import
/assets/earth_0.jpg
/assets/earth_0.jpg.import
/assets/earth_1.jpg
/assets/earth_1.jpg.import
/assets/earth_2.png
/assets/earth_2.png.import

# ISS_stationary.glb (assets/ISS/) embeds all 26 of its textures in its own
# binary buffer -- these are Godot re-extracting them to loose PNGs on every
# import, not source content. Confirmed regenerating them from a clean glb
# alone works (that is how they got here). Ignoring them keeps ~29 MB of
# pure duplicates out of history; the committed .glb is what a clone needs.
/assets/ISS/ISS_stationary_*.png
/assets/ISS/ISS_stationary_*.png.import

# Analysis output from tools/find_conjunctions.py; not consumed by the demo.
/data/conjunctions.json

# NOTE: data/ is otherwise COMMITTED ON PURPOSE, including the ~67 MB
# ephemeris. A clone is meant to run immediately, with no toolchain, no API
# keys and no network — see docs/DATA.md. Regenerating it is a deliberate act,
# not something to commit on every rebuild: each new binary adds another 67 MB
# to history permanently.
