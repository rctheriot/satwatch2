# Godot 4+ specific ignores
.godot/
/android/

# Raw upstream snapshots: large, and regenerated by tools/fetch_gp.py.
/data/gp_cache/*.json

# The propagated ephemeris is ~70 MB and is rebuilt whenever elements are
# refreshed, so it is not carried in git -- every rebuild would add another
# 70 MB blob to history. It IS packed into exported builds (see
# export_presets.cfg include_filter), so the shipped wall build is
# self-contained and needs neither the toolchain nor a network.
#
# On a fresh clone, run tools/refresh_all.py once.
/data/ephemeris.bin
.venv/

# Analysis output from tools/find_conjunctions.py; not consumed by the demo.
/data/conjunctions.json

# Build output
/build/
