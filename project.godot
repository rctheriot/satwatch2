; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3d-wall-render"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

; MUST stay "disabled". StereoWallDisplay composites the two eye viewports as
; TextureRects at absolute pixel positions (0 and resolution_width) inside
; CanvasLayer 100. Any stretch mode rescales that layer against the project's
; base resolution, so both eye images shrink and land in a corner of the wall --
; which still looks like working stereo, just small. Verified: with
; "canvas_items" a 1920x324 stereo window rendered its two eyes into 960x162.
window/stretch/mode="disabled"
window/stretch/aspect="keep"
window/size/viewport_width=1920
window/size/viewport_height=648

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
